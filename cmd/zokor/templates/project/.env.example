# Copy to .env for local runs. Read once at startup (zokor.load_config);
# the process environment wins over this file.
SERVICE_NAME=__service__
PORT=8080
# tenant:key pairs, comma-separated; a client sends its key as X-Api-Key.
# Keys are at least 32 characters.
API_KEYS=dev:change-me-change-me-change-me-0000
# LOG_FORMAT=json LOG_LEVEL=log
# TLS_CERT_FILE= TLS_KEY_FILE=

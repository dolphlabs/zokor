// Generated by cmd/zokor/gen_templates.sh from cmd/zokor/templates/; do not
// edit. Change the template files and run `make templates`.

gc struct Template {
    path: str,
    lines: [str],
}

fn project_templates() -> [Template] {
    let out: [Template] = [];
    push(out, Template { path: ".env.example", lines: [
        "# Copy to .env for local runs. Read once at startup (zokor.load_config);",
        "# the process environment wins over this file.",
        "SERVICE_NAME=__service__",
        "PORT=8080",
        "# tenant:key pairs, comma-separated; a client sends its key as X-Api-Key.",
        "# Keys are at least 32 characters.",
        "API_KEYS=dev:change-me-change-me-change-me-0000",
        "# LOG_FORMAT=json LOG_LEVEL=log",
        "# TLS_CERT_FILE= TLS_KEY_FILE="
    ] });
    push(out, Template { path: ".gitignore", lines: [
        "# built binaries and generated C",
        "/bin/",
        "main",
        "*.gen.c",
        "# local configuration: copy .env.example to .env",
        ".env",
        ".env.*",
        "!.env.example"
    ] });
    push(out, Template { path: "AGENTS.md", lines: [
        "# AGENTS.md -- __service__",
        "",
        "A zokor service, in slang. Read this before changing anything.",
        "",
        "## Commands",
        "",
        "- `make test`: every package's tests. `make check`: `zokor check`, tests",
        "  and a build; run it before you finish.",
        "- `zokor check [--json]`: the rules below, as `file:line: rule: message`",
        "  (one JSON object per line with --json). Fix what it reports.",
        "- `make run`: build and serve (configuration from `.env`, see `.env.example`).",
        "- `zokor add feature <name>`: a new feature slice, wired in. Use it rather",
        "  than writing the files by hand.",
        "- `zokor add route <feature> <METHOD> <path> <handler>`: a route under the",
        "  feature's prefix, a handler answering 501 until written, and its test.",
        "- `slangc doc zokor <name>`: zokor's API, one item at a time.",
        "",
        "## Layout",
        "",
        "```",
        "src/main.sl            startup only: config, state, mount, serve",
        "src/platform/config/   every setting, read once (settings.sl)",
        "src/platform/app/      App: the state handlers get as c.state",
        "src/platform/auth/     who the caller is (require_tenant)",
        "src/<feature>/",
        "  domain/    types and rules; pure: no I/O, no zokor",
        "  service/   use cases, and ports.sl: what it needs from storage",
        "  store/     adapters implementing those ports",
        "  server/    routes, DTOs, error codes: HTTP in and out",
        "migrations/  NNN_description.sql, applied in order by `zokor migrate`",
        "```",
        "",
        "## Rules",
        "",
        "- Imports go one way: `server -> service -> domain`; `store` implements",
        "  `service`'s ports; `platform/app` wires stores to services. A feature",
        "  reaches another only through that feature's `service`. Only `store/` and",
        "  `platform/db` import pg; `domain` and `service` do no I/O.",
        "- The tenant is an explicit argument to every use case and store call.",
        "- Every `server.sl` puts its routes behind `auth.require_tenant`; a file",
        "  of routes that are public on purpose says `// zokor:public`.",
        "- SQL is a literal with `$1, $2 ...`; values never join the text.",
        "- Configuration is read once, in `platform/config`; nothing else reads the",
        "  environment.",
        "- Every failure goes through a registered error code (`server/errors.sl`);",
        "  a store's own error is logged, never sent to a client.",
        "- Every package has a `*_test.sl` beside it. Fakes live in `*_test.sl`",
        "  files, so they never ship.",
        "- Comments say why, not what."
    ] });
    push(out, Template { path: "Makefile", lines: [
        "SLANGC ?= slangc",
        "ZOKOR ?= zokor",
        "",
        ".PHONY: test build run check",
        "",
        "# Every package with tests, found rather than listed, so a new one is",
        "# never left out.",
        "test:",
        "\t@set -e; for d in $$(find src -name '*_test.sl' | xargs -n1 dirname | sort -u); do \\",
        "\t\t$(SLANGC) test $$d; \\",
        "\tdone",
        "",
        "build:",
        "\tmkdir -p bin",
        "\t$(SLANGC) src/main.sl -o bin/__service__",
        "",
        "run: build",
        "\t./bin/__service__",
        "",
        "# The layering, tenant, SQL and config rules in AGENTS.md, then tests.",
        "check:",
        "\t$(ZOKOR) check",
        "\t$(MAKE) test build"
    ] });
    push(out, Template { path: "migrations/.gitkeep", lines: [

    ] });
    push(out, Template { path: "slang.project", lines: [
        "name __service__",
        "version 0.1.0",
        "",
        "__zokor_pin__"
    ] });
    push(out, Template { path: "src/main.sl", lines: [
        "// Startup, and nothing else: read the configuration once, build the app",
        "// state, mount every feature's routes, serve until SIGTERM.",
        "import \"zokor\";",
        "import \"platform/app\" as app;",
        "import \"platform/config\" as config;",
        "// zokor:imports -- `zokor add feature` adds each feature's server",
        "",
        "let cfg = zokor.load_config();",
        "let settings = config.settings_from(cfg);",
        "let checked = zokor.check(cfg);",
        "guard let _ok = checked else let e = err_of(checked) {",
        "    println(e);",
        "    exit(2);",
        "}",
        "let built = app.build(settings);",
        "guard let state = built else let e = err_of(built) {",
        "    println(\"cannot start: \" + e);",
        "    exit(1);",
        "}",
        "let r = zokor.new_router(state);",
        "r.health();",
        "// zokor:mount",
        "let served = zokor.listen_and_serve_with(r, settings.port, settings.server);",
        "guard let _done = served else {",
        "    exit(1);",
        "}"
    ] });
    push(out, Template { path: "src/platform/app/app.sl", lines: [
        "import \"zokor\";",
        "import \"../config\" as config;",
        "// zokor:imports -- `zokor add feature` adds each feature's service and store",
        "",
        "// The service's state: its settings and every feature's service, each",
        "// wired to its store once, here. Handlers reach it as c.state.",
        "pub gc struct App {",
        "    // zokor:fields",
        "    settings: config.Settings",
        "}",
        "",
        "pub fn build(s: config.Settings) -> result[App, str] {",
        "    return ok(App {",
        "        // zokor:build",
        "        settings: s",
        "    });",
        "}",
        "",
        "// The same state with every store in memory: what the tests build.",
        "pub fn for_tests(s: config.Settings) -> App {",
        "    return App {",
        "        // zokor:test_build",
        "        settings: s",
        "    };",
        "}"
    ] });
    push(out, Template { path: "src/platform/app/app_test.sl", lines: [
        "import \"zokor\";",
        "import \"../config\" as config;",
        "",
        "fn test_the_test_state_carries_the_settings() {",
        "    let m: map[str]str = {};",
        "    m[\"PORT\"] = \"9000\";",
        "    let a = for_tests(config.settings_from(zokor.config_from_values(m)));",
        "    assert(a.settings.port == 9000);",
        "}"
    ] });
    push(out, Template { path: "src/platform/auth/auth.sl", lines: [
        "import \"http\";",
        "import \"zokor\";",
        "import \"../app\" as app;",
        "",
        "// Who is calling: the tenant named by the request's X-Api-Key (API_KEYS).",
        "// A feature's routes run this before anything else, and read the tenant",
        "// with c.local(\"tenant_id\"); nothing else decides who a caller is.",
        "pub fn require_tenant(c: zokor.Ctx[app.App]) -> opt[http.Response] {",
        "    guard let tenant_id = zokor.api_key_client(c, c.state.settings.api_keys) else {",
        "        return some(zokor.respond(c.errors, \"unauthorized\", c.request_id));",
        "    }",
        "    c.set_local(\"tenant_id\", tenant_id);",
        "    return none;",
        "}"
    ] });
    push(out, Template { path: "src/platform/auth/auth_test.sl", lines: [
        "import \"http\";",
        "import \"zokor\";",
        "import \"../app\" as app;",
        "import \"../config\" as config;",
        "",
        "fn whoami(c: zokor.Ctx[app.App]) -> http.Response {",
        "    return zokor.text(200, c.local(\"tenant_id\"));",
        "}",
        "",
        "fn guarded() -> zokor.Router[app.App] {",
        "    let m: map[str]str = {};",
        "    m[\"PORT\"] = \"8080\";",
        "    m[\"API_KEYS\"] = \"acme:acme-key-0123456789abcdef012345\";",
        "    let r = zokor.new_router(app.for_tests(config.settings_from(zokor.config_from_values(m))));",
        "    r.before(require_tenant);",
        "    r.get(\"/whoami\", whoami);",
        "    return r;",
        "}",
        "",
        "fn test_a_known_key_names_its_tenant() {",
        "    let r = guarded().serve(zokor.get_request(\"/whoami\")",
        "                            .header(\"x-api-key\", \"acme-key-0123456789abcdef012345\").build());",
        "    assert(zokor.resp_status(r) == 200 && zokor.resp_text(r) == \"acme\", zokor.resp_text(r));",
        "}",
        "",
        "fn test_a_missing_or_wrong_key_is_401() {",
        "    let none_given = guarded().serve(zokor.get_request(\"/whoami\").build());",
        "    assert(zokor.resp_status(none_given) == 401);",
        "    let wrong = guarded().serve(zokor.get_request(\"/whoami\").header(\"x-api-key\", \"nope\").build());",
        "    assert(zokor.resp_status(wrong) == 401);",
        "}"
    ] });
    push(out, Template { path: "src/platform/config/settings.sl", lines: [
        "import \"zokor\";",
        "",
        "// Everything the service reads from its environment, read once at",
        "// startup (zokor.load_config: .env, .env.<profile>, then the process",
        "// environment). Nothing else reads configuration: handlers get these",
        "// values through the app state. Problems are recorded on `cfg`, and",
        "// zokor.check(cfg) reports them all at once.",
        "pub gc struct Settings {",
        "    service_name: str,",
        "    port: int,",
        "    // API_KEYS: comma-separated `tenant:key` pairs; the tenant is the key's name.",
        "    api_keys: zokor.ApiKeys,",
        "    // Timeouts, limits, logging, TLS: see zokor's server_config_from.",
        "    server: zokor.ServerConfig,",
        "}",
        "",
        "pub fn settings_from(cfg: zokor.Config) -> Settings {",
        "    return Settings {",
        "        service_name: zokor.str_or(cfg, \"SERVICE_NAME\", \"__service__\"),",
        "        port: zokor.require_port(cfg, \"PORT\"),",
        "        api_keys: zokor.api_keys_from(cfg),",
        "        server: zokor.server_config_from(cfg)",
        "    };",
        "}"
    ] });
    push(out, Template { path: "src/platform/config/settings_test.sl", lines: [
        "import \"zokor\";",
        "",
        "fn values(pairs: [str]) -> zokor.Config {",
        "    let m: map[str]str = {};",
        "    let i = 0;",
        "    while i + 1 < len(pairs) {",
        "        m[pairs[i]] = pairs[i + 1];",
        "        i = i + 2;",
        "    }",
        "    return zokor.config_from_values(m);",
        "}",
        "",
        "fn test_settings_are_read_once_and_checked() {",
        "    let cfg = values([\"PORT\", \"8080\", \"API_KEYS\", \"acme:0123456789abcdef0123456789abcdef\"]);",
        "    let s = settings_from(cfg);",
        "    assert(s.port == 8080);",
        "    let ok_cfg = zokor.check(cfg);",
        "    guard let _ok = ok_cfg else let e = err_of(ok_cfg) { panic(e); }",
        "}",
        "",
        "fn test_every_problem_is_reported_at_once() {",
        "    let cfg = values([\"PORT\", \"0\", \"MAX_CONNECTIONS\", \"lots\"]);",
        "    let _s = settings_from(cfg);",
        "    let r = zokor.check(cfg);",
        "    guard let _ok = r else let e = err_of(r) {",
        "        assert(strings_has(e, \"PORT\") && strings_has(e, \"MAX_CONNECTIONS\"), e);",
        "        return;",
        "    }",
        "    panic(\"a bad configuration passed\");",
        "}",
        "",
        "fn strings_has(s: str, part: str) -> bool {",
        "    let b = to_bytes(s);",
        "    let p = to_bytes(part);",
        "    let i = 0;",
        "    while i + len(p) <= len(b) {",
        "        if b[i..i + len(p)] == p { return true; }",
        "        i = i + 1;",
        "    }",
        "    return false;",
        "}"
    ] });
    return out;
}

fn light_project_templates() -> [Template] {
    let out: [Template] = [];
    push(out, Template { path: ".env.example", lines: [
        "# Copy to .env for local runs. The process environment takes precedence.",
        "PORT=8080"
    ] });
    push(out, Template { path: ".gitignore", lines: [
        "# built binaries and generated C",
        "/bin/",
        "main",
        "*.gen.c",
        "# local configuration: copy .env.example to .env",
        ".env",
        ".env.*",
        "!.env.example"
    ] });
    push(out, Template { path: "AGENTS.md", lines: [
        "# AGENTS.md -- __service__",
        "",
        "A small zokor service in slang. Read this before changing anything.",
        "",
        "## Commands",
        "",
        "- `make test`: run every package's tests; `make check`: check, test and build.",
        "- `make run`: build and serve using configuration from `.env`.",
        "- `zokor check [--json]`: check the service layout and configuration rules.",
        "- `zokor newcomp <name>`: generate the component-based service with an example",
        "  feature; use `zokor add feature <name>` there to add another feature.",
        "- `slangc doc zokor <name>`: read one item of zokor's API documentation.",
        "",
        "## Layout",
        "",
        "```",
        "src/main.sl                    startup: configuration, router and server",
        "src/platform/config/settings.sl settings read once at startup",
        "```",
        "",
        "## Rules",
        "",
        "- Configuration is read once in `platform/config`; pass settings to the router.",
        "- Keep startup wiring in `src/main.sl` and reusable setup in `src/platform/`.",
        "- Keep request handling in a package, with tests beside each package's code.",
        "- Comments say why, not what."
    ] });
    push(out, Template { path: "Makefile", lines: [
        "SLANGC ?= slangc",
        "ZOKOR ?= zokor",
        "",
        ".PHONY: test build run check",
        "",
        "test:",
        "\t@set -e; for d in $$(find src -name '*_test.sl' | xargs -n1 dirname | sort -u); do \\",
        "\t\t$(SLANGC) test $$d; \\",
        "\tdone",
        "",
        "build:",
        "\tmkdir -p bin",
        "\t$(SLANGC) src/main.sl -o bin/__service__",
        "",
        "run: build",
        "\t./bin/__service__",
        "",
        "check:",
        "\t$(ZOKOR) check",
        "\t$(MAKE) test build"
    ] });
    push(out, Template { path: "slang.project", lines: [
        "name __service__",
        "version 0.1.0",
        "",
        "__zokor_pin__"
    ] });
    push(out, Template { path: "src/main.sl", lines: [
        "// Read configuration once, use it as router state, and serve until SIGTERM.",
        "import \"zokor\";",
        "import \"platform/config\" as config;",
        "",
        "let cfg = zokor.load_config();",
        "let settings = config.settings_from(cfg);",
        "let checked = zokor.check(cfg);",
        "guard let _ok = checked else let e = err_of(checked) {",
        "    println(e);",
        "    exit(2);",
        "}",
        "let r = zokor.new_router(settings);",
        "r.health();",
        "let served = zokor.listen_and_serve_with(r, settings.port, settings.server);",
        "guard let _done = served else {",
        "    exit(1);",
        "}"
    ] });
    push(out, Template { path: "src/platform/config/settings.sl", lines: [
        "import \"zokor\";",
        "",
        "// The settings used by the service, captured once before it starts serving.",
        "pub gc struct Settings {",
        "    port: int,",
        "    server: zokor.ServerConfig,",
        "}",
        "",
        "pub fn settings_from(cfg: zokor.Config) -> Settings {",
        "    return Settings {",
        "        port: zokor.require_port(cfg, \"PORT\"),",
        "        server: zokor.server_config_from(cfg)",
        "    };",
        "}"
    ] });
    push(out, Template { path: "src/platform/config/settings_test.sl", lines: [
        "import \"zokor\";",
        "",
        "fn test_settings_keep_the_configured_port() {",
        "    let values: map[str]str = {};",
        "    values[\"PORT\"] = \"9090\";",
        "    let cfg = zokor.config_from_values(values);",
        "    let settings = settings_from(cfg);",
        "    assert(settings.port == 9090);",
        "    let checked = zokor.check(cfg);",
        "    guard let _ok = checked else let e = err_of(checked) { panic(e); }",
        "}",
        "",
        "fn test_missing_port_is_reported_by_config_check() {",
        "    let values: map[str]str = {};",
        "    let cfg = zokor.config_from_values(values);",
        "    let _settings = settings_from(cfg);",
        "    let checked = zokor.check(cfg);",
        "    guard let _ok = checked else let e = err_of(checked) {",
        "        assert(strings_has(e, \"PORT\"), e);",
        "        return;",
        "    }",
        "    panic(\"a missing PORT passed configuration validation\");",
        "}",
        "",
        "fn strings_has(s: str, part: str) -> bool {",
        "    let b = to_bytes(s);",
        "    let p = to_bytes(part);",
        "    let i = 0;",
        "    while i + len(p) <= len(b) {",
        "        if b[i..i + len(p)] == p { return true; }",
        "        i = i + 1;",
        "    }",
        "    return false;",
        "}"
    ] });
    return out;
}

fn feature_templates() -> [Template] {
    let out: [Template] = [];
    push(out, Template { path: "src/__feature__/domain/__entity__.sl", lines: [
        "// What a __entity__ is, and the rules every __entity__ keeps. Pure: no I/O, no clock,",
        "// no configuration, no zokor -- so each rule is tested directly",
        "// (note_test.sl), and the layers above can trust a __Entity__ they are given.",
        "",
        "pub gc struct __Entity__ {",
        "    id: str,",
        "    tenant_id: str,",
        "    title: str,",
        "    body: str,",
        "}",
        "",
        "// A rule a __entity__'s field broke, named by the field the client sent.",
        "pub gc struct Problem {",
        "    field: str,",
        "    reason: str,",
        "}",
        "",
        "pub fn max_title_bytes() -> int {",
        "    return 200;",
        "}",
        "",
        "pub fn max_body_bytes() -> int {",
        "    return 10000;",
        "}",
        "",
        "// Every problem with a __entity__'s fields at once; empty when it is valid.",
        "pub fn problems(title: str, body: str) -> [Problem] {",
        "    let out: [Problem] = [];",
        "    if len(title) == 0 {",
        "        push(out, Problem { field: \"title\", reason: \"must not be empty\" });",
        "    } else if len(title) > max_title_bytes() {",
        "        push(out, Problem { field: \"title\",",
        "                            reason: \"must be at most \" + to_str(max_title_bytes()) + \" bytes\" });",
        "    }",
        "    if len(body) > max_body_bytes() {",
        "        push(out, Problem { field: \"body\",",
        "                            reason: \"must be at most \" + to_str(max_body_bytes()) + \" bytes\" });",
        "    }",
        "    return out;",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/domain/__entity___test.sl", lines: [
        "fn test_a_valid_note_has_no_problems() {",
        "    assert(len(problems(\"groceries\", \"milk\")) == 0);",
        "    assert(len(problems(\"t\", \"\")) == 0, \"an empty body is allowed\");",
        "}",
        "",
        "fn test_every_problem_is_reported_with_its_field() {",
        "    let long_title = \"\";",
        "    while len(long_title) <= max_title_bytes() {",
        "        long_title = long_title + \"x\";",
        "    }",
        "    let long_body = \"\";",
        "    while len(long_body) <= max_body_bytes() {",
        "        long_body = long_body + \"0123456789\";",
        "    }",
        "    let p = problems(long_title, long_body);",
        "    assert(len(p) == 2, \"got \" + to_str(len(p)));",
        "    assert(p[0].field == \"title\" && p[1].field == \"body\");",
        "    assert(problems(\"\", \"\")[0].reason == \"must not be empty\");",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/server/dto.sl", lines: [
        "import \"zokor\";",
        "import \"../domain\" as domain;",
        "",
        "// What crosses the wire, in both directions. Requests decode into these",
        "// with zokor.dto (camelCase keys become snake_case; a missing field is a",
        "// 422 that names it); responses are rendered here, never by hand.",
        "",
        "gc struct New__Entity__ {",
        "    title: str,",
        "    body: str,",
        "}",
        "",
        "fn __entity___json(n: domain.__Entity__) -> zokor.Json {",
        "    return zokor.jobj().set_str(\"id\", n.id).set_str(\"title\", n.title).set_str(\"body\", n.body);",
        "}",
        "",
        "fn __feature___json(ns: [domain.__Entity__]) -> str {",
        "    let arr = zokor.jarr();",
        "    for n in ns {",
        "        arr.add(__entity___json(n));",
        "    }",
        "    return zokor.jobj().set(\"data\", arr).render();",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/server/errors.sl", lines: [
        "import \"http\";",
        "import \"zokor\";",
        "import \"../../platform/app\" as app;",
        "import \"../service\" as __feature__;",
        "",
        "// The __feature__ feature's error codes, registered once at startup. A failure",
        "// is answered through these and nothing else, so every client sees the",
        "// same envelope.",
        "fn register_errors(r: zokor.Registry) {",
        "    zokor.register(r, \"__feature__.not_found\", 404, \"no such __entity__\");",
        "    zokor.register(r, \"__feature__.unavailable\", 503, \"__feature__ are unavailable, try again\");",
        "}",
        "",
        "// A use case's failure, as the answer to send. A store's own error is",
        "// logged with the request id and never reaches the client.",
        "fn failure(c: zokor.Ctx[app.App], f: __feature__.Failed) -> http.Response {",
        "    if f.why == __feature__.Why.Invalid {",
        "        let fields: [zokor.FieldError] = [];",
        "        for p in f.problems {",
        "            push(fields, zokor.field(p.field, p.reason));",
        "        }",
        "        return zokor.respond_fields(c.errors, \"validation_failed\", fields, c.request_id);",
        "    }",
        "    if f.why == __feature__.Why.NotFound {",
        "        return zokor.respond(c.errors, \"__feature__.not_found\", c.request_id);",
        "    }",
        "    c.state.settings.server.logger.error(\"__feature__\", \"store failed (\" + c.request_id + \"): \" + f.detail);",
        "    return zokor.respond(c.errors, \"__feature__.unavailable\", c.request_id);",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/server/server.sl", lines: [
        "import \"http\";",
        "import \"zokor\";",
        "import \"../../platform/app\" as app;",
        "import \"../../platform/auth\" as auth;",
        "import \"../service\" as __feature__;",
        "",
        "// The __feature__ routes: HTTP in, a use case called with explicit values, HTTP",
        "// out. Nothing here decides a rule (domain/) or touches storage (store/).",
        "",
        "pub fn mount(r: zokor.Router[app.App]) -> int {",
        "    register_errors(r.errors);",
        "    let g = r.group(\"/__feature__\");",
        "    g.before(auth.require_tenant);",
        "    g.post(\"\", create___entity__);",
        "    g.get(\"\", list___feature__);",
        "    g.get(\"/:id\", show___entity__);",
        "    // zokor:routes -- `zokor add route` registers new routes here",
        "    return 0;",
        "}",
        "",
        "fn create___entity__(c: zokor.Ctx[app.App]) -> http.Response {",
        "    let dr: result[New__Entity__, http.Response] = zokor.dto(c);",
        "    guard let body = dr else let bad = err_of(dr) {",
        "        return bad;",
        "    }",
        "    let made = __feature__.create(c.state.__feature__, c.local(\"tenant_id\"), body.title, body.body);",
        "    guard let n = made else let f = err_of(made) {",
        "        return failure(c, f);",
        "    }",
        "    return zokor.created(__entity___json(n).render(), \"/__feature__/\" + n.id);",
        "}",
        "",
        "fn show___entity__(c: zokor.Ctx[app.App]) -> http.Response {",
        "    let found = __feature__.get(c.state.__feature__, c.local(\"tenant_id\"), c.param(\"id\"));",
        "    guard let n = found else let f = err_of(found) {",
        "        return failure(c, f);",
        "    }",
        "    return zokor.ok_json(__entity___json(n).render());",
        "}",
        "",
        "fn list___feature__(c: zokor.Ctx[app.App]) -> http.Response {",
        "    let offset = c.query_int(\"offset\", 0);",
        "    let limit = c.query_int(\"limit\", 50);",
        "    if limit < 1 || limit > 100 || offset < 0 {",
        "        return zokor.respond_fields(c.errors, \"validation_failed\",",
        "            [zokor.field(\"limit\", \"must be 1-100, with offset 0 or more\")], c.request_id);",
        "    }",
        "    let rows = __feature__.list(c.state.__feature__, c.local(\"tenant_id\"), offset, limit);",
        "    guard let ns = rows else let f = err_of(rows) {",
        "        return failure(c, f);",
        "    }",
        "    return zokor.ok_json(__feature___json(ns));",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/server/server_test.sl", lines: [
        "import \"http\";",
        "import \"zokor\";",
        "import \"../../platform/app\" as app;",
        "import \"../../platform/config\" as config;",
        "",
        "// The routes through the real router pipeline -- auth, decoding, the use",
        "// cases, the memory store -- without a socket.",
        "",
        "fn key_a() -> str { return \"acme-0123456789abcdef0123456789\"; }",
        "fn key_b() -> str { return \"globex-0123456789abcdef01234567\"; }",
        "",
        "fn router_under_test() -> zokor.Router[app.App] {",
        "    let m: map[str]str = {};",
        "    m[\"PORT\"] = \"8080\";",
        "    m[\"API_KEYS\"] = \"acme:\" + key_a() + \",globex:\" + key_b();",
        "    let cfg = zokor.config_from_values(m);",
        "    let r = zokor.new_router(app.for_tests(config.settings_from(cfg)));",
        "    mount(r);",
        "    return r;",
        "}",
        "",
        "fn post___entity__(r: zokor.Router[app.App], key: str, body: str) -> http.Response {",
        "    return r.serve(zokor.request(zokor.Method.POST, \"/__feature__\").header(\"x-api-key\", key)",
        "                   .json_body(body).build());",
        "}",
        "",
        "fn test_one___entity___round_trips_for_its_tenant_only() {",
        "    let r = router_under_test();",
        "    let made = post___entity__(r, key_a(), \"{\\\"title\\\":\\\"plan\\\",\\\"body\\\":\\\"ship it\\\"}\");",
        "    assert(zokor.resp_status(made) == 201, zokor.resp_text(made));",
        "    let id = zokor.resp_json(made).get(\"id\").str_or(\"\");",
        "    let mine = r.serve(zokor.get_request(\"/__feature__/\" + id).header(\"x-api-key\", key_a()).build());",
        "    assert(zokor.resp_status(mine) == 200 && zokor.resp_json(mine).get(\"title\").str_or(\"\") == \"plan\");",
        "    let theirs = r.serve(zokor.get_request(\"/__feature__/\" + id).header(\"x-api-key\", key_b()).build());",
        "    assert(zokor.resp_status(theirs) == 404 && zokor.resp_error_code(theirs) == \"__feature__.not_found\");",
        "}",
        "",
        "fn test_no_key_is_401_and_reaches_nothing() {",
        "    let r = router_under_test();",
        "    let denied = r.serve(zokor.get_request(\"/__feature__\").build());",
        "    assert(zokor.resp_status(denied) == 401, zokor.resp_text(denied));",
        "}",
        "",
        "fn test_bad_bodies_name_their_fields() {",
        "    let r = router_under_test();",
        "    let missing = post___entity__(r, key_a(), \"{\\\"title\\\":\\\"x\\\"}\");",
        "    assert(zokor.resp_status(missing) == 422);",
        "    assert(zokor.resp_error_fields(missing)[0] == \"body\", inspect(zokor.resp_error_fields(missing)));",
        "    let empty = post___entity__(r, key_a(), \"{\\\"title\\\":\\\"\\\",\\\"body\\\":\\\"\\\"}\");",
        "    assert(zokor.resp_error_fields(empty)[0] == \"title\");",
        "}",
        "",
        "fn test_listing_is_paged_and_bounded() {",
        "    let r = router_under_test();",
        "    for t in [\"a\", \"b\", \"c\"] {",
        "        let _m = post___entity__(r, key_a(), \"{\\\"title\\\":\\\"\" + t + \"\\\",\\\"body\\\":\\\"\\\"}\");",
        "    }",
        "    let page = r.serve(zokor.get_request(\"/__feature__?offset=1&limit=1\").header(\"x-api-key\", key_a()).build());",
        "    let data = zokor.resp_json(page).get(\"data\");",
        "    assert(data.size() == 1 && data.at(0).get(\"title\").str_or(\"\") == \"b\", zokor.resp_text(page));",
        "    let too_many = r.serve(zokor.get_request(\"/__feature__?limit=1000\").header(\"x-api-key\", key_a()).build());",
        "    assert(zokor.resp_status(too_many) == 422);",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/service/fakes_test.sl", lines: [
        "import \"../domain\" as domain;",
        "",
        "// A store for tests: canned answers, and a record of what it was asked.",
        "// In a _test.sl file, so it is never compiled into the service.",
        "gc struct FakeStore {",
        "    calls: [str],",
        "    rows: map[str]domain.__Entity__,",
        "    failure: str,",
        "}",
        "",
        "fn fake_store() -> FakeStore {",
        "    let calls: [str] = [];",
        "    let rows: map[str]domain.__Entity__ = {};",
        "    return FakeStore { calls: calls, rows: rows, failure: \"\" };",
        "}",
        "",
        "fn fake_insert(f: FakeStore, n: domain.__Entity__) -> result[bool, str] {",
        "    push(f.calls, \"insert \" + n.tenant_id + \"/\" + n.id);",
        "    if len(f.failure) > 0 { return err(f.failure); }",
        "    f.rows[n.tenant_id + \"/\" + n.id] = n;",
        "    return ok(true);",
        "}",
        "",
        "fn fake_find(f: FakeStore, tenant_id: str, id: str) -> result[opt[domain.__Entity__], str] {",
        "    push(f.calls, \"find \" + tenant_id + \"/\" + id);",
        "    if len(f.failure) > 0 { return err(f.failure); }",
        "    let key = tenant_id + \"/\" + id;",
        "    let absent: opt[domain.__Entity__] = none;",
        "    if !has(f.rows, key) { return ok(absent); }",
        "    return ok(some(f.rows[key]));",
        "}",
        "",
        "fn fake_list(f: FakeStore, tenant_id: str, offset: int, limit: int) -> result[[domain.__Entity__], str] {",
        "    push(f.calls, \"list \" + tenant_id);",
        "    if len(f.failure) > 0 { return err(f.failure); }",
        "    let out: [domain.__Entity__] = [];",
        "    for _k, n in f.rows {",
        "        if n.tenant_id == tenant_id { push(out, n); }",
        "    }",
        "    return ok(out);",
        "}",
        "",
        "fn fixed_id() -> str {",
        "    return \"n1\";",
        "}",
        "",
        "fn fake___feature__(f: FakeStore) -> __Feature__[FakeStore] {",
        "    return new___feature__(__Entity__Store[FakeStore] { context: f, insert: fake_insert, find: fake_find,",
        "                                            list: fake_list }, fixed_id);",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/service/ports.sl", lines: [
        "import \"../domain\" as domain;",
        "",
        "// What the service needs from storage, as function values: store/",
        "// implements them, fakes_test.sl fakes them. C is the adapter's own",
        "// state, passed explicitly (slang has no closures). An err is the store",
        "// failing -- logged, never shown to a client; absence is none, not an err.",
        "pub gc struct __Entity__Store[C] {",
        "    context: C,",
        "    insert: fn(C, domain.__Entity__) -> result[bool, str],",
        "    // tenant id, __entity__ id",
        "    find: fn(C, str, str) -> result[opt[domain.__Entity__], str],",
        "    // tenant id, offset, limit",
        "    list: fn(C, str, int, int) -> result[[domain.__Entity__], str],",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/service/service.sl", lines: [
        "import \"../domain\" as domain;",
        "",
        "// The __feature__ use cases. The tenant is an explicit argument to every one --",
        "// resolved by the HTTP edge, never read from anywhere else -- so a call",
        "// cannot reach another tenant's __feature__ by forgetting a filter.",
        "",
        "pub gc struct __Feature__[C] {",
        "    store: __Entity__Store[C],",
        "    // Makes a __entity__'s id; injected so tests get predictable ones.",
        "    new_id: fn() -> str,",
        "}",
        "",
        "pub enum Why {",
        "    Invalid,",
        "    NotFound,",
        "    Unavailable,",
        "}",
        "",
        "// Why a use case did not succeed. `problems` for Invalid; `detail` is the",
        "// store's own error for Unavailable, for the log only.",
        "pub gc struct Failed {",
        "    why: Why,",
        "    problems: [domain.Problem],",
        "    detail: str,",
        "}",
        "",
        "pub fn new___feature__[C](store: __Entity__Store[C], new_id: fn() -> str) -> __Feature__[C] {",
        "    return __Feature__[C] { store: store, new_id: new_id };",
        "}",
        "",
        "fn failed(why: Why, detail: str) -> Failed {",
        "    let none_yet: [domain.Problem] = [];",
        "    return Failed { why: why, problems: none_yet, detail: detail };",
        "}",
        "",
        "pub fn create[C](s: __Feature__[C], tenant_id: str, title: str, body: str) -> result[domain.__Entity__, Failed] {",
        "    let p = domain.problems(title, body);",
        "    if len(p) > 0 {",
        "        return err(Failed { why: Why.Invalid, problems: p, detail: \"\" });",
        "    }",
        "    let make_id = s.new_id;",
        "    let n = domain.__Entity__ { id: make_id(), tenant_id: tenant_id, title: title, body: body };",
        "    let insert = s.store.insert;",
        "    let r = insert(s.store.context, n);",
        "    guard let _ok = r else let e = err_of(r) {",
        "        return err(failed(Why.Unavailable, e));",
        "    }",
        "    return ok(n);",
        "}",
        "",
        "pub fn get[C](s: __Feature__[C], tenant_id: str, id: str) -> result[domain.__Entity__, Failed] {",
        "    let find = s.store.find;",
        "    let r = find(s.store.context, tenant_id, id);",
        "    guard let found = r else let e = err_of(r) {",
        "        return err(failed(Why.Unavailable, e));",
        "    }",
        "    guard let n = found else {",
        "        return err(failed(Why.NotFound, \"\"));",
        "    }",
        "    return ok(n);",
        "}",
        "",
        "pub fn list[C](s: __Feature__[C], tenant_id: str, offset: int, limit: int) -> result[[domain.__Entity__], Failed] {",
        "    let all = s.store.list;",
        "    let r = all(s.store.context, tenant_id, offset, limit);",
        "    guard let rows = r else let e = err_of(r) {",
        "        return err(failed(Why.Unavailable, e));",
        "    }",
        "    return ok(rows);",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/service/service_test.sl", lines: [
        "fn test_create_keeps_the_tenant_it_was_given() {",
        "    let f = fake_store();",
        "    let made = create(fake___feature__(f), \"acme\", \"groceries\", \"milk\");",
        "    guard let n = made else { panic(\"create failed\"); }",
        "    assert(n.tenant_id == \"acme\" && n.id == \"n1\");",
        "    assert(f.calls[0] == \"insert acme/n1\", f.calls[0]);",
        "}",
        "",
        "fn test_invalid_input_never_reaches_the_store() {",
        "    let f = fake_store();",
        "    let made = create(fake___feature__(f), \"acme\", \"\", \"\");",
        "    guard let _n = made else let e = err_of(made) {",
        "        assert(e.why == Why.Invalid && e.problems[0].field == \"title\");",
        "        assert(len(f.calls) == 0, \"the store was called\");",
        "        return;",
        "    }",
        "    panic(\"an empty title was accepted\");",
        "}",
        "",
        "fn test_another_tenants___entity___is_not_found() {",
        "    let f = fake_store();",
        "    let _m = create(fake___feature__(f), \"acme\", \"plan\", \"\");",
        "    let other = get(fake___feature__(f), \"globex\", \"n1\");",
        "    guard let _n = other else let e = err_of(other) {",
        "        assert(e.why == Why.NotFound);",
        "        return;",
        "    }",
        "    panic(\"globex read acme's __entity__\");",
        "}",
        "",
        "fn test_a_failing_store_is_unavailable_with_its_detail_kept() {",
        "    let f = fake_store();",
        "    f.failure = \"connection refused\";",
        "    let r = list(fake___feature__(f), \"acme\", 0, 10);",
        "    guard let _rows = r else let e = err_of(r) {",
        "        assert(e.why == Why.Unavailable && e.detail == \"connection refused\");",
        "        return;",
        "    }",
        "    panic(\"a failing store succeeded\");",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/store/memory.sl", lines: [
        "import \"../domain\" as domain;",
        "",
        "// __Feature__ kept in memory: for development, tests of the layers above, and",
        "// a service that does not need them to outlive the process. Every key",
        "// is tenant-scoped, so one tenant's id can never name another's __entity__.",
        "pub gc struct Memory {",
        "    lock: mutex,",
        "    rows: map[str]domain.__Entity__,",
        "    order: [str],",
        "}",
        "",
        "fn new_memory() -> Memory {",
        "    let rows: map[str]domain.__Entity__ = {};",
        "    let order: [str] = [];",
        "    return Memory { lock: make_mutex(), rows: rows, order: order };",
        "}",
        "",
        "fn key(tenant_id: str, id: str) -> str {",
        "    return tenant_id + \"/\" + id;",
        "}",
        "",
        "fn memory_insert(m: Memory, n: domain.__Entity__) -> result[bool, str] {",
        "    let k = key(n.tenant_id, n.id);",
        "    mutex_lock(m.lock);",
        "    let fresh = !has(m.rows, k);",
        "    if fresh {",
        "        m.rows[k] = n;",
        "        push(m.order, k);",
        "    }",
        "    mutex_unlock(m.lock);",
        "    if !fresh {",
        "        return err(\"__entity__ \" + k + \" already exists\");",
        "    }",
        "    return ok(true);",
        "}",
        "",
        "fn memory_find(m: Memory, tenant_id: str, id: str) -> result[opt[domain.__Entity__], str] {",
        "    let k = key(tenant_id, id);",
        "    mutex_lock(m.lock);",
        "    let found: opt[domain.__Entity__] = none;",
        "    if has(m.rows, k) {",
        "        found = some(m.rows[k]);",
        "    }",
        "    mutex_unlock(m.lock);",
        "    return ok(found);",
        "}",
        "",
        "fn memory_list(m: Memory, tenant_id: str, offset: int, limit: int) -> result[[domain.__Entity__], str] {",
        "    let out: [domain.__Entity__] = [];",
        "    let skipped = 0;",
        "    mutex_lock(m.lock);",
        "    for k in m.order {",
        "        let n = m.rows[k];",
        "        if n.tenant_id == tenant_id && len(out) < limit {",
        "            if skipped < offset {",
        "                skipped = skipped + 1;",
        "            } else {",
        "                push(out, n);",
        "            }",
        "        }",
        "    }",
        "    mutex_unlock(m.lock);",
        "    return ok(out);",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/store/memory_test.sl", lines: [
        "import \"../domain\" as domain;",
        "",
        "fn __entity__(tenant_id: str, id: str) -> domain.__Entity__ {",
        "    return domain.__Entity__ { id: id, tenant_id: tenant_id, title: \"t \" + id, body: \"\" };",
        "}",
        "",
        "fn test_memory_keeps_tenants_apart() {",
        "    let m = new_memory();",
        "    let _a = memory_insert(m, __entity__(\"acme\", \"1\"));",
        "    let _b = memory_insert(m, __entity__(\"globex\", \"2\"));",
        "    let mine = memory_find(m, \"acme\", \"1\");",
        "    guard let got = mine else { panic(\"find failed\"); }",
        "    guard let n = got else { panic(\"acme's __entity__ is missing\"); }",
        "    assert(n.id == \"1\");",
        "    let theirs = memory_find(m, \"acme\", \"2\");",
        "    guard let none_here = theirs else { panic(\"find failed\"); }",
        "    if let _n = none_here { panic(\"acme found globex's __entity__\"); }",
        "}",
        "",
        "fn test_memory_refuses_a_duplicate_and_pages_in_order() {",
        "    let m = new_memory();",
        "    for id in [\"1\", \"2\", \"3\"] {",
        "        let _r = memory_insert(m, __entity__(\"acme\", id));",
        "    }",
        "    let again = memory_insert(m, __entity__(\"acme\", \"1\"));",
        "    if let _ok = again { panic(\"a duplicate id was inserted\"); }",
        "    let page = memory_list(m, \"acme\", 1, 1);",
        "    guard let rows = page else { panic(\"list failed\"); }",
        "    assert(len(rows) == 1 && rows[0].id == \"2\", inspect(len(rows)));",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/store/store.sl", lines: [
        "import \"../domain\" as domain;",
        "import \"../service\" as service;",
        "",
        "// Which adapter __feature__ is stored with, chosen at startup in",
        "// platform/app: one type for all of them, so the app state and every test",
        "// above this layer stay the same whichever is in use.",
        "pub gc struct Store {",
        "    memory: Memory",
        "}",
        "",
        "// Kept in this process (development, tests).",
        "pub fn in_memory() -> service.__Entity__Store[Store] {",
        "    return service.__Entity__Store[Store] { context: Store { memory: new_memory() },",
        "                                         insert: store_insert, find: store_find,",
        "                                         list: store_list };",
        "}",
        "",
        "fn store_insert(s: Store, n: domain.__Entity__) -> result[bool, str] {",
        "    return memory_insert(s.memory, n);",
        "}",
        "",
        "fn store_find(s: Store, tenant_id: str, id: str) -> result[opt[domain.__Entity__], str] {",
        "    return memory_find(s.memory, tenant_id, id);",
        "}",
        "",
        "fn store_list(s: Store, tenant_id: str, offset: int, limit: int) -> result[[domain.__Entity__], str] {",
        "    return memory_list(s.memory, tenant_id, offset, limit);",
        "}"
    ] });
    return out;
}

fn pg_project_templates() -> [Template] {
    let out: [Template] = [];
    push(out, Template { path: ".env.example", lines: [
        "# Copy to .env for local runs. Read once at startup (zokor.load_config);",
        "# the process environment wins over this file.",
        "SERVICE_NAME=__service__",
        "PORT=8080",
        "# tenant:key pairs, comma-separated; a client sends its key as X-Api-Key.",
        "# Keys are at least 32 characters.",
        "API_KEYS=dev:change-me-change-me-change-me-0000",
        "# LOG_FORMAT=json LOG_LEVEL=log",
        "# TLS_CERT_FILE= TLS_KEY_FILE=",
        "DATABASE_URL=postgres://__service__:__service__@127.0.0.1:5432/__service__",
        "# DB_POOL_SIZE=10"
    ] });
    push(out, Template { path: "src/main.sl", lines: [
        "// Startup, and nothing else: read the configuration once, open the",
        "// database, build the app state, mount every feature's routes, serve",
        "// until SIGTERM.",
        "import \"zokor\";",
        "import \"platform/app\" as app;",
        "import \"platform/config\" as config;",
        "import \"platform/db\" as db;",
        "// zokor:imports -- `zokor add feature` adds each feature's server",
        "",
        "let cfg = zokor.load_config();",
        "let settings = config.settings_from(cfg);",
        "let checked = zokor.check(cfg);",
        "guard let _ok = checked else let e = err_of(checked) {",
        "    println(e);",
        "    exit(2);",
        "}",
        "let opened = db.open(cfg);",
        "guard let pool = opened else let e = err_of(opened) {",
        "    println(\"cannot open the database: \" + e);",
        "    exit(1);",
        "}",
        "let built = app.build(settings, pool);",
        "guard let state = built else let e = err_of(built) {",
        "    println(\"cannot start: \" + e);",
        "    exit(1);",
        "}",
        "let r = zokor.new_router(state);",
        "r.health();",
        "// zokor:mount",
        "let served = zokor.listen_and_serve_with(r, settings.port, settings.server);",
        "guard let _done = served else {",
        "    exit(1);",
        "}"
    ] });
    push(out, Template { path: "src/platform/app/app.sl", lines: [
        "import \"zokor\";",
        "import \"../config\" as config;",
        "import \"../db\" as db;",
        "// zokor:imports -- `zokor add feature` adds each feature's service and store",
        "",
        "// The service's state: its settings and every feature's service, each",
        "// wired to its store once, here. Handlers reach it as c.state.",
        "pub gc struct App {",
        "    // zokor:fields",
        "    settings: config.Settings",
        "}",
        "",
        "pub fn build(s: config.Settings, d: db.Db) -> result[App, str] {",
        "    return ok(App {",
        "        // zokor:build",
        "        settings: s",
        "    });",
        "}",
        "",
        "// The same state with every store in memory: what the tests build.",
        "pub fn for_tests(s: config.Settings) -> App {",
        "    return App {",
        "        // zokor:test_build",
        "        settings: s",
        "    };",
        "}"
    ] });
    push(out, Template { path: "src/platform/app/app_test.sl", lines: [
        "import \"zokor\";",
        "import \"../config\" as config;",
        "",
        "fn test_the_test_state_carries_the_settings() {",
        "    let m: map[str]str = {};",
        "    m[\"PORT\"] = \"9000\";",
        "    let a = for_tests(config.settings_from(zokor.config_from_values(m)));",
        "    assert(a.settings.port == 9000);",
        "}"
    ] });
    push(out, Template { path: "src/platform/db/db.sl", lines: [
        "import \"pg\";",
        "import \"zokor\";",
        "",
        "// The service's one Postgres pool: DATABASE_URL, DB_POOL_SIZE (10). Only",
        "// this package and the features' store/ packages import pg; everything",
        "// else holds a Db.",
        "pub gc struct Db {",
        "    pool: pg.Pool,",
        "}",
        "",
        "pub fn open(cfg: zokor.Config) -> result[Db, str] {",
        "    let r = zokor.pg_from_config(cfg);",
        "    guard let pool = r else let e = err_of(r) {",
        "        return err(e);",
        "    }",
        "    return ok(Db { pool: pool });",
        "}"
    ] });
    push(out, Template { path: "src/platform/db/db_test.sl", lines: [
        "import \"zokor\";",
        "",
        "fn test_without_a_database_url_the_pool_says_so() {",
        "    let m: map[str]str = {};",
        "    let r = open(zokor.config_from_values(m));",
        "    if let _p = r {",
        "        panic(\"a pool opened with no DATABASE_URL\");",
        "    }",
        "}"
    ] });
    return out;
}

fn pg_feature_templates() -> [Template] {
    let out: [Template] = [];
    push(out, Template { path: "migrations/__seq_____feature__.sql", lines: [
        "-- __feature__: one row per __entity__, scoped to its tenant.",
        "create table __feature__ (",
        "    tenant_id text not null,",
        "    id text not null,",
        "    title text not null,",
        "    body text not null default '',",
        "    created_at timestamptz not null default now(),",
        "    primary key (tenant_id, id)",
        ");"
    ] });
    push(out, Template { path: "src/__feature__/store/postgres.sl", lines: [
        "import \"pg\";",
        "import \"time\";",
        "import \"zokor\";",
        "import \"../domain\" as domain;",
        "",
        "// __Feature__ in Postgres. Every query is parameterised ($1, ...) and",
        "// names its tenant; rows decode by column name into domain.__Entity__.",
        "pub gc struct Postgres {",
        "    pool: pg.Pool,",
        "    // How long one query may take, in nanoseconds.",
        "    timeout: int,",
        "}",
        "",
        "fn new_postgres(pool: pg.Pool) -> Postgres {",
        "    return Postgres { pool: pool, timeout: 2000000000 };",
        "}",
        "",
        "fn deadline(p: Postgres) -> until {",
        "    return until_of(time.mono() + p.timeout);",
        "}",
        "",
        "fn pg_insert(p: Postgres, n: domain.__Entity__) -> result[bool, str] {",
        "    let r: result[[domain.__Entity__], str] = zokor.query_all(p.pool,",
        "        \"insert into __feature__ (tenant_id, id, title, body) values ($1, $2, $3, $4) \" +",
        "        \"returning tenant_id, id, title, body\",",
        "        [pg.arg_text(n.tenant_id), pg.arg_text(n.id), pg.arg_text(n.title), pg.arg_text(n.body)],",
        "        deadline(p));",
        "    guard let _rows = r else let e = err_of(r) {",
        "        return err(e);",
        "    }",
        "    return ok(true);",
        "}",
        "",
        "fn pg_find(p: Postgres, tenant_id: str, id: str) -> result[opt[domain.__Entity__], str] {",
        "    return zokor.query_one(p.pool,",
        "        \"select tenant_id, id, title, body from __feature__ where tenant_id = $1 and id = $2\",",
        "        [pg.arg_text(tenant_id), pg.arg_text(id)], deadline(p));",
        "}",
        "",
        "fn pg_list(p: Postgres, tenant_id: str, offset: int, limit: int) -> result[[domain.__Entity__], str] {",
        "    return zokor.query_all(p.pool,",
        "        \"select tenant_id, id, title, body from __feature__ where tenant_id = $1 \" +",
        "        \"order by created_at, id offset $2 limit $3\",",
        "        [pg.arg_text(tenant_id), pg.arg_int(offset), pg.arg_int(limit)], deadline(p));",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/store/postgres_test.sl", lines: [
        "import \"proc\";",
        "import \"time\";",
        "import \"zokor\";",
        "import \"../domain\" as domain;",
        "",
        "// Against a real database when TEST_DATABASE_URL is set (the migrations",
        "// are applied first); skipped, and says so, when it is not.",
        "fn live() -> opt[Postgres] {",
        "    let none_here: opt[Postgres] = none;",
        "    let url = proc.getenv(\"TEST_DATABASE_URL\") ?? \"\";",
        "    if len(url) == 0 {",
        "        println(\"skip __feature__ postgres tests (TEST_DATABASE_URL is not set)\");",
        "        return none_here;",
        "    }",
        "    let m: map[str]str = {};",
        "    m[\"DATABASE_URL\"] = url;",
        "    let opened = zokor.pg_from_config(zokor.config_from_values(m));",
        "    guard let pool = opened else let e = err_of(opened) { panic(e); }",
        "    let ms = zokor.load_migrations(\"migrations\", zokor.migration_limits());",
        "    guard let loaded = ms else let e = err_of(ms) { panic(e); }",
        "    let applied = zokor.migrate(pool, loaded, until_of(time.mono() + 30000000000));",
        "    guard let _n = applied else let e = err_of(applied) { panic(e); }",
        "    return some(new_postgres(pool));",
        "}",
        "",
        "fn test_postgres_keeps_tenants_apart_and_pages() {",
        "    guard let p = live() else { return; }",
        "    let tenant = \"t-\" + zokor.new_session_id();",
        "    for id in [\"a\", \"b\", \"c\"] {",
        "        let r = pg_insert(p, domain.__Entity__ { id: id, tenant_id: tenant, title: id, body: \"\" });",
        "        guard let _ok = r else let e = err_of(r) { panic(e); }",
        "    }",
        "    let found = pg_find(p, tenant, \"b\");",
        "    guard let got = found else let e = err_of(found) { panic(e); }",
        "    guard let n = got else { panic(\"b is missing\"); }",
        "    assert(n.title == \"b\");",
        "    let other = pg_find(p, \"someone-else\", \"b\");",
        "    guard let none_found = other else { panic(\"find failed\"); }",
        "    if let _x = none_found { panic(\"another tenant's row was found\"); }",
        "    let page = pg_list(p, tenant, 1, 1);",
        "    guard let rows = page else let e = err_of(page) { panic(e); }",
        "    assert(len(rows) == 1 && rows[0].id == \"b\");",
        "}"
    ] });
    push(out, Template { path: "src/__feature__/store/store.sl", lines: [
        "import \"pg\";",
        "import \"../domain\" as domain;",
        "import \"../service\" as service;",
        "",
        "// Which adapter __feature__ is stored with, chosen at startup in",
        "// platform/app: one type for all of them, so the app state and every test",
        "// above this layer stay the same whichever is in use.",
        "pub gc struct Store {",
        "    memory: opt[Memory],",
        "    postgres: opt[Postgres]",
        "}",
        "",
        "// Kept in this process (development, tests).",
        "pub fn in_memory() -> service.__Entity__Store[Store] {",
        "    let none_pg: opt[Postgres] = none;",
        "    return wrap(Store { memory: some(new_memory()), postgres: none_pg });",
        "}",
        "",
        "// In Postgres: the table migrations/ creates.",
        "pub fn on_postgres(pool: pg.Pool) -> service.__Entity__Store[Store] {",
        "    let none_mem: opt[Memory] = none;",
        "    return wrap(Store { memory: none_mem, postgres: some(new_postgres(pool)) });",
        "}",
        "",
        "fn wrap(s: Store) -> service.__Entity__Store[Store] {",
        "    return service.__Entity__Store[Store] { context: s, insert: store_insert, find: store_find,",
        "                                         list: store_list };",
        "}",
        "",
        "fn store_insert(s: Store, n: domain.__Entity__) -> result[bool, str] {",
        "    if let p = s.postgres { return pg_insert(p, n); }",
        "    guard let m = s.memory else { return err(\"no store\"); }",
        "    return memory_insert(m, n);",
        "}",
        "",
        "fn store_find(s: Store, tenant_id: str, id: str) -> result[opt[domain.__Entity__], str] {",
        "    if let p = s.postgres { return pg_find(p, tenant_id, id); }",
        "    guard let m = s.memory else { return err(\"no store\"); }",
        "    return memory_find(m, tenant_id, id);",
        "}",
        "",
        "fn store_list(s: Store, tenant_id: str, offset: int, limit: int) -> result[[domain.__Entity__], str] {",
        "    if let p = s.postgres { return pg_list(p, tenant_id, offset, limit); }",
        "    guard let m = s.memory else { return err(\"no store\"); }",
        "    return memory_list(m, tenant_id, offset, limit);",
        "}"
    ] });
    return out;
}
